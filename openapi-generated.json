  "components": {
    "schemas": {
      "AttendanceCorrection": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "punch_in": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Punch In"
          },
          "punch_out": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Punch Out"
          },
          "half_day": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Half Day"
          }
        },
        "type": "object",
        "title": "AttendanceCorrection"
      },
      "EmployeeIn": {
        "properties": {
          "emp_code": {
            "type": "string",
            "pattern": "^EMP\\d{4,6}$",
            "title": "Emp Code"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "department": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Department"
          },
          "shift_start": {
            "type": "string",
            "title": "Shift Start",
            "default": "09:30"
          },
          "shift_end": {
            "type": "string",
            "title": "Shift End",
            "default": "18:30"
          },
          "joined_on": {
            "type": "string",
            "title": "Joined On"
          }
        },
        "type": "object",
        "required": [
          "emp_code",
          "name",
          "email",
          "department",
          "joined_on"
        ],
        "title": "EmployeeIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PunchInIn": {
        "properties": {
          "emp_code": {
            "type": "string",
            "title": "Emp Code"
          },
          "punched_at": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 4102444800000.0,
                "minimum": 100000000000.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Punched At"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "PRESENT"
          }
        },
        "type": "object",
        "required": [
          "emp_code"
        ],
        "title": "PunchInIn"
      },
      "PunchOutRequest": {
        "properties": {
          "emp_code": {
            "type": "string",
            "title": "Emp Code"
          },
          "punched_at": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 4102444800000.0,
                "minimum": 1000000000000.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Punched At"
          }
        },
        "type": "object",
        "required": [
          "emp_code"
        ],
        "title": "PunchOutRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}